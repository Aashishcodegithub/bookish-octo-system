# Fraud Detection Starter Kit - Environment Configuration
PROJECT_NAME="Fraud Detection API"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Configuration
# In production, generate with: openssl rand -hex 32
JWT_SECRET_KEY="super-secret-enterprise-fraud-detection-jwt-key-change-in-prod"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fraud Engine Rules Configuration
FRAUD_HIGH_RISK_THRESHOLD=75
FRAUD_REVIEW_THRESHOLD=45
FRAUD_MAX_SINGLE_TRANSACTION_AMOUNT=25000.00
FRAUD_VELOCITY_WINDOW_SECONDS=300
FRAUD_VELOCITY_MAX_COUNT=5
FRAUD_IMPOSSIBLE_TRAVEL_KMH=900.0

# API Settings
API_V1_STR="/api/v1"
CORS_ORIGINS=["*"]
